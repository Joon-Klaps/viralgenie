/*
========================================================================================
    Nextflow config file for running tests for the MAP_READS subworkflow
========================================================================================
*/

// The unmapped-read filter for the contig alignments is not in the subworkflow, it is the
// ext.args2 expression in the `.*MAP_READS_CONTIGS:*` blocks of conf/modules.config, keyed on
// the alias SCAFFOLDS_EXTEND_STATS imports MAP_READS under. Running MAP_READS directly names
// the processes `MAP_READS:BWAMEM2_MEM`, which that selector does not match, so the same
// expression is repeated here. It has to stay in sync with conf/modules.config -- what the
// tests below pin is that the expression behaves, not that it is still the one in production.
//
// As in production, this fully qualified selector takes precedence over the bare
// `withName: BWAMEM2_MEM` / `withName: BOWTIE2_ALIGN` blocks that also match.

process {

    // publishing needs meta.iteration/step, which these tests do not set
    withName: ".*MAP_READS:.*" {
        publishDir = [ enabled: false ]
    }

    withName: ".*MAP_READS:BWAMEM2_MEM" {
        ext.args2 = { params.keep_unmapped ? '-O BAM' : "-O BAM -l 0 -@ ${task.cpus} -o - | samtools view -F 4 -O BAM" }
    }

    withName: ".*MAP_READS:BOWTIE2_ALIGN" {
        ext.args  = { "--seed 1 --reorder" }
        ext.args2 = { params.keep_unmapped ? '-O BAM' : "-O BAM -l 0 -@ ${task.cpus} -o - | samtools view -F 4 -O BAM" }
    }
}
