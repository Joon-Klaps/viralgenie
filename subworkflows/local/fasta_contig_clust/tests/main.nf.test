                input[2] = Channel.of([])
                input[3] = BLAST_MAKEBLASTDB.out.db
                input[4] = Channel.of([
                    [id:'sarscov2_db'],
                    file(params.pipelines_testdata_base_path + '/db/sarscov2.fasta', checkIfExists: true)
                ])
                input[5] = KRAKEN2_DB_UNTAR.out.untar.map{ meta, db -> db }
