                input[2] = Channel.of([])
                input[3] = [] // no blast db
                input[4] = [] // no sequencing db
                input[5] = Channel.of([])
                input[6] = Channel.of([])
                input[7] = []
                input[8] = "vsearch"
                input[9] = 0.85
