    test("sarscov2 - contigs + fastq - vrhyme") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [id:'test', sample:'test', single_end:false],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true),
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = Channel.of([[id:'test', sample:'test'], [file(params.pipelines_testdata_base_path + '/genomes/coverages_spades.idxstats', checkIfExists: true)]])
                input[2] = Channel.of([])
                input[3] = BLAST_MAKEBLASTDB.out.db
                input[4] = Channel.of([
                    [id:'sarscov2_db'],
                    file(params.pipelines_testdata_base_path + '/db/sarscov2.fasta', checkIfExists: true)
                ])
                input[5] = Channel.of([])
                input[6] = Channel.of([])
                input[7] = []
                input[8] = "vrhyme"
                input[9] = 0.85
                input[10] = true
                input[11] = 0
                input[12] = true
