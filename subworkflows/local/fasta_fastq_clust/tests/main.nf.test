nextflow_workflow {

    name "Test Workflow FASTA_FASTQ_CLUST"
    script "../main.nf"
    workflow "FASTA_FASTQ_CLUST"
    config './nextflow.config'

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/fasta_fastq_clust"
    tag "fasta_fastq_clust"
    tag "vsearch/cluster"
    tag "cdhit/cdhitest"
    tag "mmseqs/createdb"
    tag "mmseqs/linclust"
    tag "mmseqs/cluster"
    tag "mmseqs/createtsv"
    tag "vrhyme/vrhyme"
    tag "mash/dist"
    tag "clusty"



    test("sarscov2 - fasta - vsearch") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    []
                ])
                input[1] = "vsearch"
                input[2] = 0.81
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.clusters,
                ).match() }
            )
        }
    }

    test("sarscov2 - fasta - vsearch | multiple genomes") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fasta/contigs.fasta', checkIfExists: true),
                    []
                ])
                input[1] = "vsearch"
                input[2] = 0.81
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.clusters,
                ).match() }
            )
        }
    }

