nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "default"

    def scenarios = [
        [
            name: "-profile test",
            tag: "default",
            scope: "files",
            bam: true,
            vcf: true,
            overview: true,
        ],
        // Variant caller matrix: same `test` profile, different params.
        // Mirrors the combinations used in .github/workflows/ci.yml.
        [
            name: "-profile test - variant_caller bcftools - consensus_caller bcftools",
            tag: "default",
            scope: "versions",
            params: [
                variant_caller: "bcftools",
                consensus_caller: "bcftools",
                skip_assembly: true, // running out of memory on CI
            ],
        ],
        [
            name: "-profile test - variant_caller ivar - consensus_caller bcftools",
            tag: "default",
            scope: "versions",
            params: [
                variant_caller: "ivar",
                consensus_caller: "bcftools",
                skip_assembly: true,
            ],
        ],
        [
            name: "-profile test - variant_caller ivar - consensus_caller ivar",
            tag: "default",
            scope: "versions",
            params: [
                variant_caller: "ivar",
                consensus_caller: "ivar",
                skip_assembly: true,
            ],
        ],
        [
            name: "-profile test - use_host_filtered_reads",
            tag: "host_filtered",
            scope: "files",
            bam: true,
            vcf: true,
            overview: true,
            params: [
                use_host_filtered_reads: true,
                skip_assembly: true, // running out of memory on CI
            ],
        ],
    ]

    scenarios.each { scenario -> test(scenario.name, UTILS.getTest(scenario)) }
}
